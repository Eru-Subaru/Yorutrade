{
  "name": "yorutrade",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm --workspace=web run build",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm --workspace=web run dev",
    "dev:api": "npm --workspace=api run dev"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.34.0"
  }
}
